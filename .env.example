# LOCAL DEVELOPMENT ONLY. Copy to .env and fill in. .env is gitignored.
#
# PRODUCTION USES NONE OF THIS FILE. On Lightsail these values live in AWS SSM
# Parameter Store under /futureacad/prod/ (secrets as SecureString), and are
# fetched into /run/futureacad/env (tmpfs) by futureacad-secrets.service at
# start-up. Nothing secret is written to the instance's disk, and nothing
# secret passes through GitHub Actions.
#
#   Seed them:   bash deploy/seed-ssm.sh
#   Rotate them: update the parameter, then
#                sudo systemctl restart futureacad-secrets futureacad
#
# See DEPLOY.md.

# REQUIRED in production — random secret signing the session/CSRF cookie.
# The app REFUSES TO START in production while this is the dev placeholder.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-insecure-key-change-me

# Admin dashboard login (/admin). Also guarded at startup in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=futureacad

# Set to 1 in production (behind HTTPS).
SESSION_COOKIE_SECURE=0

# Proxy hops in front of the app. nginx = 1. Set 0 if nothing proxies.
PROXY_HOPS=1

# ---- Database ----
# LOCAL: leave blank -> SQLite at instance/futureacad.db (automatic).
# PRODUCTION: must point INSIDE shared/ so the data survives every release:
#   DATABASE=/var/www/futureacad/shared/instance/futureacad.db
# POSTGRES_URL takes priority over DATABASE when set (future scaling path).
# DATABASE=
# POSTGRES_URL=postgres://user:pass@host/db?sslmode=require

# ---- Email (every lead is emailed here) ----
# Amazon SES SMTP credentials — NOT your AWS access keys. Create them under
# SES -> SMTP settings -> Create SMTP credentials. Leave SMTP_HOST blank to
# disable email entirely; leads are still stored and visible at /admin.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@futureacad.ae
LEAD_NOTIFY=leads@futureacad.ae
