[Unit]
Description=Fetch FutureAcad secrets from AWS SSM Parameter Store into tmpfs
Documentation=https://github.com/rooman-itsd/futureacad/blob/main/DEPLOY.md
After=network-online.target
Wants=network-online.target
Before=futureacad.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Scoped, read-only IAM credentials — ssm:GetParametersByPath on one path plus
# kms:Decrypt on one key. Root-owned, chmod 600. This is the only long-lived
# credential on the instance, and it can read nothing else in the account.
EnvironmentFile=/etc/futureacad/aws.env

Environment=SSM_PATH=/futureacad/prod/
Environment=OUT=/run/futureacad/env

# /run is tmpfs: decrypted secrets live in RAM only, never on disk.
# Preserve the directory so it survives a restart of this unit.
RuntimeDirectory=futureacad
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

ExecStart=/usr/local/bin/futureacad-fetch-secrets

# A transient SSM/network blip must not leave the site down permanently.
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=futureacad-secrets

[Install]
WantedBy=multi-user.target
